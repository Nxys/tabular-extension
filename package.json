{
  "name": "browser-selection-copy",
  "version": "1.0.0",
  "description": "浏览器框选复制插件 - Chrome扩展",
  "type": "module",
  "scripts": {
    "test": "jest",
    "build": "tsc --outDir build/dist",
    "lint": "eslint src/**/*.ts",
    "pack": "node build/package-extension.js",
    "release": "npm run lint && npm run test && npm run pack"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.8",
    "@types/jsdom": "^21.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "fast-check": "^3.15.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/src/test/setup.ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "useESM": true
      }]
    },
    "extensionsToTreatAsEsm": [".ts"],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/*.test.ts"
    ]
  }
}