{
  "manifest_version": 3,
  "name": "浏览器框选复制插件",
  "version": "1.0.0",
  "description": "通过鼠标拖拽创建选择框，智能提取并复制页面文本",
  
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_title": "框选复制文本"
  },
  
  "icons": {
    "16": "assets/icon16.svg",
    "32": "assets/icon32.svg", 
    "48": "assets/icon48.svg",
    "128": "assets/icon128.svg"
  }
}